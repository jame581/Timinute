@using Timinute.Client.Helpers
@using Timinute.Client.Models
@using Timinute.Shared.Dtos.Project

@inject Timinute.Client.Services.AuroraDialogService Dialogs
@inject IHttpClientFactory ClientFactory
@inject NotificationService NotificationService
@inject Timinute.Client.Services.UndoNotificationService UndoNotifier

<EditForm Model="@model" OnValidSubmit="OnSubmit" class="aurora-form">
    <DataAnnotationsValidator />
    <TaskEntryFields Model="model" Projects="projects" ShowTags="true" RangeError="@rangeError" />
    <div class="aurora-form__actions">
        <AuroraButton Variant="danger-ghost" Class="aurora-form__actions-start" OnClick="OnDeleteClick">Delete</AuroraButton>
        <AuroraButton Variant="ghost" OnClick="() => Dialogs.Close(Entry, null)">Cancel</AuroraButton>
        <AuroraButton Type="submit">Save</AuroraButton>
    </div>
</EditForm>

@code {
    [CascadingParameter] public Timinute.Client.Services.DialogEntry? Entry { get; set; }


    [Parameter]
    public TrackedTask TrackedTask { get; set; }

    private TrackedTask model = new TrackedTask();

    private readonly List<Project> projects = new();

    protected override async Task OnInitializedAsync()
    {
        // Bind the model before the first await: the form renders while projects load, and an
        // EditForm must not switch models (and EditContexts) after its inputs have rendered.
        model = TrackedTask;
        model.TagIds ??= new List<string>();
        await LoadProjects();
    }

    private string? rangeError;

    private void OnSubmit()
    {
        rangeError = TaskEntryFields.ValidateRange(model);
        if (rangeError != null) return;
        Dialogs.Close(Entry, model);
    }

    async Task OnDeleteClick()
    {
        var client = ClientFactory.CreateClient(Constants.API.ClientName);

        try
        {
            var responseMessage = await client.DeleteAsync($"{Constants.API.TrackedTask.Delete}/{model.TaskId}");

            responseMessage.EnsureSuccessStatusCode();

            var taskId = model.TaskId;
            var taskName = model.Name;
            UndoNotifier.ShowUndo("Task", taskName, async () =>
            {
                await client.PostAsync(Constants.API.TrackedTask.Restore(taskId), null);
            });

            Dialogs.Close(Entry, null);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Something happened", ex.Message, 5000);
        }
    }

    private async Task LoadProjects()
    {
        var client = ClientFactory.CreateClient(Constants.API.ClientName);

        try
        {
            var responseMessage = await client.GetFromJsonAsync<List<ProjectDto>>(Constants.API.Project.Get);

            if (responseMessage != null)
            {
                projects.Clear();
                foreach (var projectDto in responseMessage)
                {
                    projects.Add(new Project(projectDto));
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Something happened", ex.Message, 5000);
        }
    }
}